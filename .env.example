# URL de la base PostgreSQL de Supabase: solo servidor, nunca Vite
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@<DB-HOST>:5432/postgres
# Ejemplo: https://abc123.supabase.co (sin / al final)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Credencial privada SOLO PARA EL BACKEND; necesaria para fotos
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=reciwise-reportes
# Orígenes permitidos; no usar * junto con autenticación
CORS_ORIGINS=http://localhost:5173
